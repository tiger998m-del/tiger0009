# =============================================================================
# Binance Spot Trading Bot -- Environment Configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file (it is already in .gitignore).
# =============================================================================

# --- Binance API credentials -------------------------------------------------
# Create an API key on Binance with "Enable Spot & Margin Trading" permission
# ONLY. Do NOT enable withdrawals. Do NOT enable Futures.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
RECV_WINDOW_MS=5000
TIME_DRIFT_MAX_MS=1000

# --- Telegram -----------------------------------------------------------------
# Create a bot with @BotFather to get TELEGRAM_BOT_TOKEN.
# Message your bot once, then use @userinfobot (or the getUpdates API) to find
# your numeric TELEGRAM_CHAT_ID. TELEGRAM_USERNAME is for display/labeling only
# -- actual delivery always uses the bot token + chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=@tiger007KSA

# --- Capital ------------------------------------------------------------------
# Capital allocated to THIS BOT ONLY, in SAR. Changing this value and
# restarting the bot is the ONLY way to change the trading capital --
# no source code edit is ever required.
BOT_CAPITAL_SAR=1000
# Manual, explicit SAR->USDT conversion rate (see README "Engineering
# Decisions" for why this is a fixed .env value rather than a live FX API).
SAR_PER_USDT=3.75

# --- Mode -----------------------------------------------------------------
# DRY_RUN=false is the default: LIVE TRADING MODE with real funds.
# Set DRY_RUN=true for paper trading / testing with simulated fills.
DRY_RUN=false

# --- Position sizing / limits -----------------------------------------------
TRADE_ALLOCATION_PCT=0.48
MAX_OPEN_POSITIONS=2
QUOTE_ASSET=USDT

# --- Strategy targets -----------------------------------------------------
TAKE_PROFIT_PCT=0.03
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
INITIAL_SL_MAX_PCT=3.0
MIN_RISK_REWARD=1.25

# --- Universe screening -----------------------------------------------------
MIN_MARKET_CAP_USD=50000000
MIN_VOLUME_24H_USD=50000000
UNIVERSE_REFRESH_MINUTES=60
UNIVERSE_MAX_SYMBOLS=40
MARKET_CAP_CHECK_ENABLED=true
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CAP_CACHE_MINUTES=30

# --- Daily stop / pause -----------------------------------------------------
DAILY_STOP_PCT=0.02
CONSECUTIVE_LOSS_LIMIT=2
PAUSE_MINUTES=60

# --- Candles ----------------------------------------------------------------
KLINE_INTERVAL=5m
CANDLE_HISTORY_LIMIT=300

# --- Order execution ----------------------------------------------------------
ORDER_POLL_INTERVAL_SECONDS=2
ORDER_POLL_TIMEOUT_SECONDS=30
TP_POLL_INTERVAL_SECONDS=5

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Database -----------------------------------------------------------------
DB_PATH=data/bot.db
